# Copy to .env.local for local development. Values are baked in at build time.

# Backend services (see the IncidentAlert repository)
VITE_API_URL=http://localhost:5002
VITE_ML_URL=http://localhost:5004
VITE_STATISTICS_URL=http://localhost:5006

# Optional. OAuth client ID for "Sign in with Google" (student accounts).
# Leave empty to hide the Google button.
VITE_GOOGLE_CLIENT_ID=

# Optional. Enables translating incident text between Serbian and English
# through the Google Cloud Translation API.
VITE_GOOGLE_API_KEY=
